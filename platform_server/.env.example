# 复制成 .env 再改。所有项都能用环境变量覆盖(前缀 MC_)
MC_DEBUG=true

# 开发默认 sqlite;上线换 PostgreSQL:
# MC_DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/matrixcat
MC_DATABASE_URL=sqlite+aiosqlite:///./matrixcat.db

MC_REDIS_URL=redis://127.0.0.1:6379/0

# 上线务必换成长随机串(比如 python -c "import secrets;print(secrets.token_urlsafe(48))")
MC_JWT_SECRET=dev-only-change-me
MC_ACCESS_TTL_MIN=30
MC_REFRESH_TTL_DAYS=14

MC_SMS_PROVIDER=console
MC_SMS_DEBUG_ECHO=true
